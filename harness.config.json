{
  "exclude": [
    "**/node_modules/**",
    "**/.git/**",
    "**/dist/**",
    "**/coverage/**",
    "CONCEPT.md",
    ".claude/worktrees/**"
  ],
  "codeGlobs": [
    "src/**/*.ts",
    "tools/**/*.ts"
  ],
  "boardPath": "forge/BOARD.md",
  "index": {
    "skipDirs": [".claude/agents", ".claude/skills/*"],
    "claudeMdSummary": {
      "root": "Harness entrypoint",
      "other": "Directory-scoped agent guidance"
    },
    "fallbackDate": "1970-01-01"
  },
  "frontmatter": {
    "base": {
      "title": {
        "kind": "string",
        "required": true
      },
      "summary": {
        "kind": "string",
        "required": true
      },
      "keywords": {
        "kind": "array",
        "required": true
      },
      "type": {
        "kind": "enum",
        "required": true
      },
      "status": {
        "kind": "enum",
        "required": true
      },
      "updated": {
        "kind": "date",
        "required": true
      },
      "related": {
        "kind": "array"
      },
      "budget_override": {
        "kind": "object"
      },
      "generated": {
        "kind": "boolean"
      },
      "related_code": {
        "kind": "array"
      }
    },
    "statusSets": {
      "docs": [
        "draft",
        "active",
        "deprecated"
      ],
      "workflow": [
        "backlog",
        "ready",
        "in-progress",
        "review",
        "done",
        "blocked", "cancelled"
      ]
    },
    "types": {
      "doc": {
        "statuses": "docs"
      },
      "research": {
        "statuses": "docs"
      },
      "adr": {
        "statuses": "docs"
      },
      "gdd": {
        "statuses": "docs"
      },
      "guide": {
        "statuses": "docs"
      },
      "index": {
        "statuses": "docs"
      },
      "epic": {
        "statuses": "workflow",
        "fields": {
          "id": {
            "kind": "string",
            "required": true,
            "pattern": "^E\\d{3}$"
          },
          "priority": {
            "kind": "enum",
            "required": true,
            "values": [
              "p0",
              "p1",
              "p2",
              "p3"
            ]
          }
        }
      },
      "task": {
        "statuses": "workflow",
        "fields": {
          "id": {
            "kind": "string",
            "required": true,
            "pattern": "^T\\d{3}$"
          },
          "epic": {
            "kind": "string",
            "required": true,
            "pattern": "^E\\d{3}$"
          },
          "priority": {
            "kind": "enum",
            "required": true,
            "values": [
              "p0",
              "p1",
              "p2",
              "p3"
            ]
          },
          "model": {
            "kind": "enum",
            "required": true,
            "values": [
              "opus",
              "sonnet"
            ]
          },
          "size": {
            "kind": "enum",
            "required": true,
            "values": [
              "S",
              "M"
            ]
          },
          "depends_on": {
            "kind": "array"
          },
          "assignee": {
            "kind": "string"
          }
        }
      },
      "review": {
        "statuses": "docs",
        "fields": {
          "id": {
            "kind": "string",
            "required": true,
            "pattern": "^R\\d{3}$"
          },
          "task": {
            "kind": "string",
            "required": true,
            "pattern": "^T\\d{3}$"
          },
          "verdict": {
            "kind": "enum",
            "required": true,
            "values": [
              "approved",
              "changes-requested"
            ]
          }
        }
      },
      "retro": {
        "statuses": "docs",
        "fields": {
          "id": {
            "kind": "string",
            "required": true,
            "pattern": "^RT\\d{3}$"
          }
        }
      }
    },
    "special": [
      { "kind": "index", "glob": "**/INDEX.md" },
      {
        "kind": "skill",
        "glob": ".claude/skills/*/SKILL.md",
        "required": [
          "name",
          "description"
        ],
        "titleField": "name",
        "summaryField": "description"
      },
      {
        "kind": "agent",
        "glob": ".claude/agents/*.md",
        "required": [
          "name",
          "description"
        ],
        "titleField": "name",
        "summaryField": "description"
      },
      {
        "kind": "claude",
        "glob": "**/CLAUDE.md"
      },
      {
        "kind": "exempt",
        "glob": ".claude/skills/**"
      }
    ]
  },
  "budgets": {
    "md_lines": { "value": 300, "warn_at": 200, "severity": "error", "unit": "lines", "description": "Max lines in a Markdown doc (generated files exempt)", "area": "docs", "enforced_by": "harness" },
    "md_tokens": { "value": 6000, "warn_at": 4500, "severity": "error", "unit": "tokens (chars/3)", "description": "Max estimated tokens (chars/3) in a Markdown doc", "area": "docs", "enforced_by": "harness" },
    "md_toc_over_lines": { "value": 100, "severity": "warn", "unit": "lines", "description": "Docs longer than this need a \"## Contents\" section", "area": "docs", "enforced_by": "harness" },
    "md_heading_depth": { "value": 3, "severity": "warn", "unit": "heading level", "description": "Deepest allowed heading level in a doc body", "area": "docs", "enforced_by": "harness" },
    "md_code_block_lines": { "value": 40, "severity": "warn", "unit": "lines", "description": "Max lines in one fenced code block (json blocks exempt)", "area": "docs", "enforced_by": "harness" },
    "broken_links": { "value": 0, "fixed": true, "severity": "error", "unit": "links", "description": "Broken relative Markdown links or related paths", "area": "docs", "enforced_by": "harness" },
    "fm_title_chars": { "value": 60, "severity": "error", "unit": "chars", "description": "Max length of frontmatter title", "area": "docs", "enforced_by": "harness" },
    "fm_summary_chars": { "value": 200, "severity": "error", "unit": "chars", "description": "Max length of frontmatter summary", "area": "docs", "enforced_by": "harness" },
    "fm_keywords_min": { "value": 3, "cmp": "min", "severity": "error", "unit": "items", "description": "Min keywords per doc", "area": "docs", "enforced_by": "harness" },
    "fm_keywords_max": { "value": 8, "severity": "error", "unit": "items", "description": "Max keywords per doc", "area": "docs", "enforced_by": "harness" },
    "fm_related_max": { "value": 8, "severity": "warn", "unit": "items", "description": "Max entries in frontmatter related", "area": "docs", "enforced_by": "harness" },
    "dir_files": { "value": 15, "warn_at": 10, "severity": "error", "unit": "files", "description": "Max files per directory (INDEX.md excluded)", "area": "docs", "enforced_by": "harness" },
    "dir_subdirs": { "value": 10, "severity": "warn", "unit": "dirs", "description": "Max subdirectories per directory", "area": "docs", "enforced_by": "harness" },
    "dir_depth": { "value": 4, "severity": "error", "unit": "levels", "description": "Max directory nesting depth from the repo root", "area": "docs", "enforced_by": "harness" },
    "index_tokens": { "value": 2500, "severity": "warn", "unit": "tokens", "description": "Max estimated tokens in a generated INDEX.md", "area": "docs", "enforced_by": "harness" },
    "claude_md_lines": { "value": 120, "warn_at": 100, "severity": "error", "unit": "lines", "description": "Max lines in a CLAUDE.md", "area": "docs", "enforced_by": "harness" },
    "claude_md_tokens": { "value": 2500, "severity": "error", "unit": "tokens", "description": "Max estimated tokens in a CLAUDE.md", "area": "docs", "enforced_by": "harness" },
    "always_loaded_tokens": { "value": 6000, "severity": "error", "unit": "tokens", "description": "Tokens loaded every session: all CLAUDE.md plus skill and agent descriptions", "area": "docs", "enforced_by": "harness" },
    "rule_file_lines": { "value": 60, "severity": "warn", "unit": "lines", "description": "Max lines in a .claude/rules file", "area": "docs", "enforced_by": "harness" },
    "auto_memory_lines": { "value": 150, "severity": "warn", "unit": "lines", "description": "Max lines in the auto-memory MEMORY.md (lives outside the repo)", "area": "docs", "enforced_by": "process" },
    "skill_md_lines": { "value": 300, "warn_at": 200, "severity": "error", "unit": "lines", "description": "Max lines in a SKILL.md", "area": "docs", "enforced_by": "harness" },
    "skill_md_tokens": { "value": 5000, "severity": "error", "unit": "tokens", "description": "Max estimated tokens in a SKILL.md", "area": "docs", "enforced_by": "harness" },
    "skill_name_chars": { "value": 64, "fixed": true, "severity": "error", "unit": "chars", "description": "Max length of a skill name (platform limit)", "area": "docs", "enforced_by": "harness" },
    "skill_description_chars": { "value": 1024, "warn_at": 300, "fixed": true, "severity": "error", "unit": "chars", "description": "Max length of a skill description (platform limit)", "area": "docs", "enforced_by": "harness" },
    "skill_count": { "value": 20, "severity": "warn", "unit": "skills", "description": "Max number of skills", "area": "docs", "enforced_by": "harness" },
    "skill_ref_depth": { "value": 1, "severity": "error", "unit": "levels", "description": "Max link depth from skill reference files", "area": "docs", "enforced_by": "process" },
    "agent_def_count": { "value": 8, "severity": "warn", "unit": "agents", "description": "Max number of agent definitions", "area": "docs", "enforced_by": "harness" },
    "agent_descriptions_tokens": { "value": 3000, "severity": "warn", "unit": "tokens", "description": "Max estimated tokens in all agent descriptions combined", "area": "docs", "enforced_by": "harness" },
    "adr_lines": { "value": 100, "severity": "warn", "unit": "lines", "description": "Max lines in an ADR", "area": "docs", "enforced_by": "harness" },
    "adr_active": { "value": 15, "severity": "warn", "unit": "ADRs", "description": "Max ADRs with status active", "area": "docs", "enforced_by": "harness" },
    "doc_stale_days": { "value": 90, "severity": "warn", "unit": "days since updated", "description": "Active docs not updated for this many days are stale", "area": "docs", "enforced_by": "harness" },
    "harness_review_days": { "value": 14, "severity": "process", "unit": "days", "description": "Review CLAUDE.md, skills and agents at least this often", "area": "docs", "enforced_by": "process" },
    "ts_file_lines": { "value": 300, "warn_at": 200, "severity": "error", "unit": "lines (no blank/comment)", "description": "Max code lines (no blank/comment) per non-test TS file", "area": "code", "enforced_by": "harness" },
    "test_file_lines": { "value": 500, "severity": "warn", "unit": "lines", "description": "Max lines per test file", "area": "code", "enforced_by": "harness" },
    "fn_lines": { "value": 50, "warn_at": 30, "severity": "error", "unit": "lines", "description": "Max lines per function (brace heuristic)", "area": "code", "enforced_by": "harness" },
    "fn_params": { "value": 4, "severity": "error", "unit": "params", "description": "Max parameters per function", "area": "code", "enforced_by": "biome" },
    "complexity": { "value": 10, "severity": "error", "unit": "cyclomatic", "description": "Max cyclomatic complexity per function", "area": "code", "enforced_by": "biome" },
    "nesting_depth": { "value": 3, "severity": "error", "unit": "blocks", "description": "Max block nesting depth", "area": "code", "enforced_by": "biome" },
    "nested_callbacks": { "value": 3, "severity": "error", "unit": "callbacks", "description": "Max nested callbacks", "area": "code", "enforced_by": "biome" },
    "line_chars": { "value": 100, "severity": "error", "unit": "chars", "description": "Max characters per code line", "area": "code", "enforced_by": "biome" },
    "exports_per_module": { "value": 10, "severity": "warn", "unit": "exports", "description": "Max exports per module", "area": "code", "enforced_by": "biome" },
    "imports_per_module": { "value": 15, "severity": "warn", "unit": "imports", "description": "Max imports per module", "area": "code", "enforced_by": "biome" },
    "circular_deps": { "value": 0, "fixed": true, "severity": "error", "unit": "cycles", "description": "Circular dependencies between modules", "area": "code", "enforced_by": "biome" },
    "duplication_pct": { "value": 3, "severity": "warn", "unit": "% duplicated lines", "description": "Max percentage of duplicated lines", "area": "code", "enforced_by": "biome" },
    "comment_line_chars": { "value": 100, "severity": "error", "unit": "chars", "description": "Max length of a comment line", "area": "code", "enforced_by": "harness" },
    "comment_block_lines": { "value": 10, "warn_at": 5, "severity": "error", "unit": "lines", "description": "Max consecutive comment lines", "area": "code", "enforced_by": "harness" },
    "comment_ratio": { "value": 0.25, "severity": "warn", "unit": "comment/code lines", "description": "Max comment/code line ratio per file", "area": "code", "enforced_by": "harness" },
    "todo_untracked": { "value": 0, "severity": "error", "unit": "markers", "description": "TODO/FIXME/HACK/XXX markers without a T### or B### id", "area": "code", "enforced_by": "harness" },
    "todo_total": { "value": 15, "severity": "warn", "unit": "markers", "description": "Max TODO/FIXME/HACK/XXX markers repo-wide", "area": "code", "enforced_by": "harness" },
    "explicit_any": { "value": 0, "severity": "error", "unit": "occurrences", "description": "Explicit any occurrences", "area": "code", "enforced_by": "biome" },
    "ts_ignore": { "value": 0, "severity": "error", "unit": "occurrences", "description": "@ts-ignore / @ts-nocheck occurrences", "area": "code", "enforced_by": "biome" },
    "ts_expect_error": { "value": 5, "severity": "warn", "unit": "occurrences", "description": "Max @ts-expect-error occurrences", "area": "code", "enforced_by": "biome" },
    "eslint_disable": { "value": 5, "severity": "warn", "unit": "occurrences", "description": "Max lint-disable comments", "area": "code", "enforced_by": "biome" },
